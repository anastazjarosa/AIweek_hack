# Copy to .env.local (git-ignored) and fill in. The app runs without these: the Simulation Lab
# then falls back to the closest ready-made experiment and a self-check instead of AI feedback.

# Anthropic API key for the simulation agent (question → experiment) and explanation feedback.
ANTHROPIC_API_KEY=

# Set to "off" to force the offline path, e.g. on stage with unreliable Wi-Fi.
# MOSAIC_AI=off
